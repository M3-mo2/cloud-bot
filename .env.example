# cloud-bot configuration — copy to `.env` and fill in.  EVERY value below is a NAME, never a secret.
#
# The application reads these through pydantic-settings (see cloudbot/core/config.py);
# the `CLOUDBOT_` prefix is what maps them onto a field. An empty value is the documented
# safe default unless noted.

# ── required ───────────────────────────────────────────────────────────────────
# From @BotFather. The bot REFUSES to start without it ("CLOUDBOT_BOT_TOKEN is not set").
# ⚠️ One token = one long-poller. If this token is already running somewhere else,
#    the two processes fight over getUpdates and BOTH appear broken (Telegram returns
#    a Conflict to whichever asks second). For local development, create a SEPARATE
#    bot with @BotFather and put the new token here.
CLOUDBOT_BOT_TOKEN=

# ── runtime mode: production | dev | debug ────────────────────────────────────
# dev    ⇒ verbose errors, relaxed throttling, admin diagnostics on, MOCK ENGINE allowed
# debug  ⇒ everything above plus raw engine payloads in the UI, no throttling
# production ⇒ JSON logs, no raw payloads, strict throttling
# Use `dev` locally. See cloudbot/core/modes.py for the full behaviour table.
CLOUDBOT_MODE=dev

# ── the sandbox engine (cloud-service) ────────────────────────────────────────
# Where the engine listens. The engine binds 127.0.0.1 only, so a bot on another
# machine cannot reach it directly — that is why the production bot runs on the
# same host as the engine. To develop against a real engine from elsewhere, put a
# Cloudflare tunnel in front of it and use the tunnel URL here (see docs/LOCAL-DEV.md).
CLOUDBOT_ENGINE_BASE_URL=http://127.0.0.1:8098

# The engine's API key, sent as `Authorization: Bearer <key>`. ONE key for the whole
# bot: end users never see it and never get their own. Only needed when mock_engine
# is false. A tunnel URL plus this key means anyone with both can create workspaces
# on your host — rotate the key if it ever leaves the server.
CLOUDBOT_ENGINE_API_KEY=

# Engine request timeout (seconds) and retry count for transient failures.
CLOUDBOT_ENGINE_TIMEOUT_S=30
CLOUDBOT_ENGINE_MAX_RETRIES=2

# ── local state ───────────────────────────────────────────────────────────────
# The bot's OWN SQLite database: users, their workspaces, terminal sessions, the
# admin event log. Unrelated to the engine's storage. The directory must exist
# (`mkdir -p data`) because SQLite will not create it.
CLOUDBOT_DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# ── the people who may open /admin ────────────────────────────────────────────
# Comma-separated Telegram user ids. Being an admin is an IDENTITY, not a mode:
# an id listed here reaches the panel even in production, and a user not listed
# gets the ordinary "unknown command" path so they cannot even tell the panel exists.
CLOUDBOT_ADMIN_IDS=

# ── presentation ──────────────────────────────────────────────────────────────
# ar | en. Only affects the default; a user's own choice is stored per user.
CLOUDBOT_DEFAULT_LOCALE=ar

# Minimum seconds between two actions from the same user. Relaxed in dev.
CLOUDBOT_THROTTLE_RATE=5

# structlog level; empty means "use the mode's default".
CLOUDBOT_LOG_LEVEL=

# Allow raw engine payloads inside error screens. Only honoured in debug mode, and
# then only for an admin id — a normal user never sees raw engine output.
CLOUDBOT_DEBUG_SHOW_RAW=false

# ── development only ──────────────────────────────────────────────────────────
# true ⇒ the bot talks to an in-process FakeEngine instead of cloud-service, so the
# ENTIRE UI runs with no engine, no network and no key. Ignored unless the mode is
# dev (see cloudbot/core/modes.py: mock_engine_allowed). This is the fastest way to
# develop a screen or a handler locally.
CLOUDBOT_MOCK_ENGINE=false

# ── developer tools ───────────────────────────────────────────────────────────
# true ⇒ the admin-only in-bot developer tools are reachable (currently `/dev`, a
# live button inspector: it renders any screen, shows each button's callback/style
# and its live verdict, and lets an admin "tap" a button through the real
# dispatcher with a fake bot — nothing reaches Telegram, nothing reaches the
# engine, nothing mutates state). OFF by default; on top of this switch it is
# still gated on the admin identity (CLOUDBOT_ADMIN_IDS), so a non-admin can
# never reach it even when the switch is on. Keep it off in production.
CLOUDBOT_DEV_TOOLS=false
