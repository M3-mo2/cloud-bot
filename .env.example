# cloud-bot configuration (example — copy to .env and fill in real values)
#
# Never commit a real .env. The bot holds exactly one Cloud Service bearer key
# and one Telegram bot token; both are secrets.

# PRODUCTION | DEV | DEBUG  (unknown values are a fatal configuration error)
CLOUDBOT_MODE=production

# Telegram bot token (SecretStr). Required to start the bot.
CLOUDBOT_BOT_TOKEN=123456:replace-me

# Cloud Service engine origin and the single bearer service key.
CLOUDBOT_ENGINE_BASE_URL=http://127.0.0.1:8098
CLOUDBOT_ENGINE_API_KEY=replace-me

# Per-request timeout (seconds) and transient retry budget (idempotent verbs only).
CLOUDBOT_ENGINE_TIMEOUT_S=30
CLOUDBOT_ENGINE_MAX_RETRIES=2

# SQLite DSN. The schema lives under adapters/persistence/migrations/.
CLOUDBOT_DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Comma-separated Telegram ids allowed to use admin/debug commands.
# DEBUG with an empty list is refused at startup.
CLOUDBOT_ADMIN_IDS=

# Fallback locale before a user chooses: ar | en
CLOUDBOT_DEFAULT_LOCALE=en

# Per-user message rate (messages/second).
CLOUDBOT_THROTTLE_RATE=5

# Optional explicit log level; derived from the mode when empty.
CLOUDBOT_LOG_LEVEL=

# DEBUG only: surface collapsed raw engine payloads to admins.
CLOUDBOT_DEBUG_SHOW_RAW=false

# DEV only: serve deterministic fixtures instead of calling the engine.
CLOUDBOT_MOCK_ENGINE=false
